# Copy to .env (git-ignored) and fill in what you need.

# Absolute path to a project root folder to open when a dev build starts, so a
# restart costs no trip through the picker. The folder needs the same things
# File > Open checks for: a shashoku/ directory holding a .shashoku-project
# sentinel. Ignored by packaged builds.
RENDERER_VITE_DEV_PROJECT=
