{
  "name": "shashoku",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "main": "out/main/index.js",
  "description": "Shashoku — a manga translation and typesetting tool",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:build": "pnpm --filter @shashoku/engine build",
    "engine:build:debug": "pnpm --filter @shashoku/engine build:debug",
    "engine:build:win32": "pnpm --filter @shashoku/engine build:win32",
    "engine:check-win32-imports": "./scripts/check-engine-imports",
    "sidecar:sync": "uv sync --project python",
    "sidecar:build-win32": "./scripts/build-sidecar-win32",
    "installer:build-win32": "./scripts/build-installer-win32",
    "check:rust-format": "cargo fmt --all -- --check",
    "check:rust-lints": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --workspace --locked",
    "check:python-lock": "uv lock --check --project python",
    "check:source": "pnpm check:rust-format && pnpm check:python-lock && pnpm check:rust-lints && pnpm test:rust && pnpm engine:build:debug && pnpm typecheck && pnpm build && pnpm test",
    "check:flake-eval": "./scripts/check-flake-eval",
    "check:nix-artifacts": "./scripts/check-nix-artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shashoku/engine": "workspace:*",
    "@tanstack/vue-virtual": "^3.13.34",
    "@vueuse/core": "^14.3.0",
    "clsx": "^2.1.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  }
}
