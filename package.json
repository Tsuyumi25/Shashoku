{
  "name": "shashoku",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "main": "out/main/index.js",
  "description": "Shashoku — a manga translation and typesetting tool",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:build": "pnpm --filter @shashoku/engine build",
    "engine:build:debug": "pnpm --filter @shashoku/engine build:debug",
    "sidecar:sync": "uv sync --project python"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "~43.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shashoku/engine": "workspace:*",
    "@tanstack/vue-virtual": "^3.13.34",
    "@vueuse/core": "^14.3.0",
    "clsx": "^2.1.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  }
}
