{
  "name": "@shashoku/engine",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "shashoku-engine",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path Cargo.toml",
    "build:debug": "napi build --platform --manifest-path Cargo.toml",
    "build:win32": "napi build --platform --release --manifest-path Cargo.toml --target x86_64-pc-windows-msvc --cross-compile"
  }
}
